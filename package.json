{
  "name": "jet-paths",
  "version": "4.0.2",
  "description": "A TypeScript-first utility for composing, validating, and formatting URL paths using nested objects.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "clean": "rm -rf lib",
    "install:clean": "rm -rf ./node_modules && rm -f package-lock.json && npm i",
    "commit": "npm run format && git add -A && git commit -m \"dev commit\"",
    "commit:push": "npm run commit && git push",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:lib": "node test/ai/lib.smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run test:run && npm run build && npm run test:lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanpmaxwell/jet-paths.git"
  },
  "keywords": [
    "typescript",
    "url",
    "urls",
    "url-builder",
    "path-builder",
    "path",
    "paths",
    "routes",
    "nested-routes",
    "api",
    "rest",
    "http",
    "type-safe",
    "type-inference",
    "query-params",
    "search-params",
    "esm"
  ],
  "author": "sean maxwell",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seanpmaxwell/jet-paths/issues"
  },
  "homepage": "https://github.com/seanpmaxwell/jet-paths#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.1",
    "@types/node": "^26.6.3",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jet-logger": "^3.0.0",
    "jiti": "^2.6.1",
    "playwright": "^1.63.0",
    "prettier": "^3.7.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
