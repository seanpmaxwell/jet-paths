{
  "name": "jet-paths",
  "version": "4.0.0",
  "description": "A TypeScript-first utility for composing, validating, and formatting URL paths using nested objects.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "clean:install": "rm -rf ./node_modules && rm -f package-lock.json && npm i",
    "commit": "npm run format && git add -A && git commit -m \"dev commit\"",
    "commit:push": "npm run commit && git push",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:dist": "node test/dist.smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && vitest run && npm run build && npm run test:dist",
    "prepack": "mv README.md README-git.md && cp assets/README-npm.md README.md",
    "postpack": "mv README-git.md README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanpmaxwell/jet-paths.git"
  },
  "keywords": [
    "typescript",
    "url",
    "urls",
    "routing",
    "routes",
    "path",
    "paths",
    "api",
    "rest",
    "http",
    "type-safe",
    "typesafe",
    "regex",
    "validation",
    "parameters",
    "string-formatting",
    "developer-tools"
  ],
  "author": "sean maxwell",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seanpmaxwell/jet-paths/issues"
  },
  "homepage": "https://github.com/seanpmaxwell/jet-paths#readme",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.15"
  }
}
